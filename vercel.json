{
  "public": true,
  "rewrites": [
    {
      "source": "/examples/face-comparison/(.*)",
      "destination": "/examples/face-comparison/$1"
    }
  ],
  "headers": [
    {
      "source": "/face-api-weights/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
